// Assets & Capital — enterprise data model
// PostgreSQL via Prisma. Run: npx prisma generate && npx prisma migrate dev
// This schema is the source of truth the UI maps to; wire it to a database
// (e.g. Supabase Postgres) and replace the sample data in lib/* with queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Names match the Vercel↔Supabase integration defaults (pooled for queries,
  // non-pooling for migrations). If you set the DB URLs manually, use these
  // same names or tell me and I'll switch them.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ------------------------------------------------------------ enums

enum Role {
  INVESTOR
  BUSINESS
  ADMIN
  SUPER_ADMIN
  STAFF
}

enum OrgType {
  INVESTOR
  BUSINESS
}

enum InvestorClass {
  PRIVATE_EQUITY
  REAL_ESTATE
  FUND
}

enum InvestorType {
  INDIVIDUAL
  FAMILY_OFFICE
  INSTITUTIONAL
  PENSION_FUND
  SOVEREIGN_WEALTH_FUND
  OTHER
}

enum ListingTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum ListingStatus {
  DRAFT
  IN_REVIEW
  LIVE
  IN_DILIGENCE
  CLOSED
  WITHDRAWN
}

enum Instrument {
  DEBT
  EQUITY
  PREFERRED_EQUITY
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DealStage {
  MATCHED
  INTRO
  NDA
  DATA_ROOM
  DILIGENCE
  TERM_SHEET
  CLOSED
  PASSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}

enum CommitmentStatus {
  SOFT_COMMITTED
  ALLOCATED
  AGREEMENT_SENT
  SIGNED
  FUNDED
  WITHDRAWN
}

// ------------------------------------------------------------ identity

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  name               String?
  passwordHash       String?
  role               Role                  @default(INVESTOR)
  emailVerified      DateTime?
  twoFactorOn        Boolean               @default(false)
  orgId              String?
  organization       Organization?         @relation(fields: [orgId], references: [id])
  messages           Message[]             @relation("MessageSender")
  notifications      Notification[]
  auditLogs          AuditLog[]
  subscription       InvestorSubscription?
  interests          ListingInterest[]
  ndaSignatures      NdaSignature[]
  savedListings      SavedListing[]
  paymentIntents     PaymentIntent[]
  commitments        Commitment[]
  kyc                KycRecord?
  docAccess          DocumentAccessLog[]
  uploads            MediaAsset[]          @relation("MediaUploader")
  articles           Article[]             @relation("ArticleAuthor")
  /**
   * Last heartbeat from a signed-in staff member. Drives the live/away badge
   * visitors see — presence is derived from recency, not a boolean someone
   * has to remember to switch off.
   */
  staffSeenAt        DateTime?
  meetingsAsInvestor Meeting[]             @relation("MeetingInvestor")
  meetingsAsBusiness Meeting[]             @relation("MeetingBusiness")
  meetingsOrganised  Meeting[]             @relation("MeetingOrganiser")
  chats              ChatConversation[]    @relation("ChatVisitor")
  chatReplies        ChatMessage[]         @relation("ChatAuthor")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([orgId])
}

// ------------------------------------------------------------ per-user entitlements
// Slug-keyed to the current marketplace data. When listings move fully into the
// DB (Tier 2) these gain a Listing FK; the resolver stays the same.

model InvestorSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Data-room documents. Files live in object storage; only the key is stored.
/// Downloads go through /api/documents/[id], which re-checks entitlements.
model DataRoomDocument {
  id         String              @id @default(cuid())
  slug       String
  name       String
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  accessLogs DocumentAccessLog[]
  createdAt  DateTime            @default(now())

  @@index([slug])
}

model DocumentAccessLog {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   DataRoomDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action     String
  ip         String?
  createdAt  DateTime         @default(now())

  @@index([documentId])
  @@index([userId])
}

/// The investment transaction: soft commit → allocation → agreement → funded.
model Commitment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String
  amountUsd    Int
  status       CommitmentStatus @default(SOFT_COMMITTED)
  allocatedUsd Int?
  signedAt     DateTime?
  fundedAt     DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, slug])
  @@index([status])
}

/// Investor compliance: identity, accreditation and screening outcomes.
model KycRecord {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         KycStatus @default(NOT_STARTED)
  accredited     Boolean   @default(false)
  sanctionsClear Boolean   @default(false)
  pepMatch       Boolean   @default(false)
  provider       String?
  reference      String?
  legalName      String?
  country        String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// A checkout attempt. Subscriptions are only ever activated from an intent
/// this server marked SUCCEEDED — never from a client call.
model PaymentIntent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference   String        @unique
  provider    String
  plan        String
  amountLabel String
  status      PaymentStatus @default(PENDING)
  testMode    Boolean       @default(true)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model ListingInterest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

model NdaSignature {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

model Organization {
  id           String           @id @default(cuid())
  type         OrgType
  legalName    String
  country      String?
  region       String?
  kycStatus    KycStatus        @default(NOT_STARTED)
  users        User[]
  investor     InvestorProfile?
  business     BusinessProfile?
  documents    Document[]
  payments     Payment[]
  media        MediaAsset[]     @relation("OrgMedia")
  subscription Subscription?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ------------------------------------------------------------ investor side

model InvestorProfile {
  id           String             @id @default(cuid())
  orgId        String             @unique
  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  investorType InvestorType
  accredited   Boolean            @default(false)
  jurisdiction String?
  mandates     Mandate[]
  saved        SavedOpportunity[]
  watchlist    Watchlist[]
  createdAt    DateTime           @default(now())
}

model Mandate {
  id            String          @id @default(cuid())
  investorId    String
  investor      InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorClass InvestorClass
  name          String
  objectives    String[]
  strategies    String[]
  instruments   Instrument[]
  regions       String[]
  sectors       String[]
  exclusions    String[]
  ticketMin     Int?
  ticketTarget  Int?
  ticketMax     Int?
  targetIrr     Float?
  thesis        String?
  status        String          @default("active")
  matches       Match[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([investorId])
}

// ------------------------------------------------------------ business side

model BusinessProfile {
  id             String       @id @default(cuid())
  orgId          String       @unique
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website        String?
  foundedYear    Int?
  legalStructure String?
  verified       Boolean      @default(false)
  listings       Listing[]
  createdAt      DateTime     @default(now())
}

model Listing {
  id            String             @id @default(cuid())
  businessId    String
  business      BusinessProfile    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title         String
  summary       String?
  industryId    String?
  industry      Industry?          @relation(fields: [industryId], references: [id])
  region        String?
  country       String?
  stage         String?
  instrument    Instrument?
  askAmount     Int?
  equityOffered Float?
  returnOffer   String?
  tier          ListingTier        @default(STANDARD)
  status        ListingStatus      @default(DRAFT)
  featuredUntil DateTime?
  views         Int                @default(0)
  documents     Document[]
  matches       Match[]
  savedBy       SavedOpportunity[]
  /// Images belonging to this business, uploaded by them or by staff.
  media         MediaAsset[]       @relation("ListingMedia")
  /// The card/hero image. Falls back to sector imagery when unset.
  heroId        String?
  hero          MediaAsset?        @relation("ListingHero", fields: [heroId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([industryId])
  @@index([status])
}

model Industry {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  categories Category[]
  listings   Listing[]
}

model Category {
  id         String   @id @default(cuid())
  name       String
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([industryId, name])
}

// ------------------------------------------------------------ matching & deals

model Match {
  id        String    @id @default(cuid())
  mandateId String
  mandate   Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score     Int
  stage     DealStage @default(MATCHED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([mandateId, listingId])
  @@index([stage])
}

model SavedOpportunity {
  id         String          @id @default(cuid())
  investorId String
  investor   InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([investorId, listingId])
}

model Watchlist {
  id         String          @id @default(cuid())
  investorId String
  investor   InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  label      String
  createdAt  DateTime        @default(now())
}

// ------------------------------------------------------------ engagement

model Message {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  sender    User      @relation("MessageSender", fields: [senderId], references: [id])
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Document {
  id           String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  listingId    String?
  listing      Listing?      @relation(fields: [listingId], references: [id])
  name         String
  storageKey   String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime      @default(now())
}

// ------------------------------------------------------------ events

model Roadshow {
  id          String   @id @default(cuid())
  title       String
  location    String?
  date        DateTime
  requestedBy String?
  createdAt   DateTime @default(now())
}

model Event {
  id        String   @id @default(cuid())
  title     String
  type      String
  location  String?
  date      DateTime
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------ commerce

model Subscription {
  id           String           @id @default(cuid())
  orgId        String           @unique
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tier         ListingTier
  active       Boolean          @default(true)
  renewsAt     DateTime?
  provider     PaymentProvider?
  createdAt    DateTime         @default(now())
}

model Payment {
  id           String          @id @default(cuid())
  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceNo    String          @unique
  description  String
  amountCents  Int
  currency     String          @default("USD")
  provider     PaymentProvider
  status       PaymentStatus   @default(PENDING)
  isSuccessFee Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([status])
}

// ------------------------------------------------------------ ops

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  entityId  String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name])
}

// ------------------------------------------------------------ media & editorial

/// Every image on the site, stored once and referenced everywhere.
///
/// The bytes live on disk (see lib/media-store.ts), not in the database — a row
/// here is the catalogue entry. `storageKey` is the filename under that
/// directory, so moving to object storage later changes one module and no rows.
///
/// Everything is WebP under 100KB by the time it reaches this table; the
/// original is never kept, which is why `originalName` and `originalBytes`
/// record what was handed in.
model MediaAsset {
  id            String  @id @default(cuid())
  storageKey    String  @unique
  thumbKey      String?
  originalName  String
  originalBytes Int
  bytes         Int
  width         Int
  height        Int
  quality       Int
  /// Author-supplied description. Empty string means explicitly decorative.
  alt           String  @default("")
  /// Free-text grouping shown in the library filter (e.g. "listings", "insights").
  folder        String?

  uploadedById String?
  uploadedBy   User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Optional owner. A business's own image is scoped to it so the library can
  /// show "belongs to Accra FinPay" rather than an anonymous pile.
  listingId    String?
  listing      Listing?      @relation("ListingMedia", fields: [listingId], references: [id], onDelete: SetNull)
  orgId        String?
  organization Organization? @relation("OrgMedia", fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  articleCovers Article[] @relation("ArticleCover")
  listingHeroes Listing[] @relation("ListingHero")

  @@index([folder])
  @@index([listingId])
  @@index([createdAt])
}

/// A published insight. Replaces the hardcoded ARTICLES array in
/// lib/insights-data.ts so the marketing site is editable without a deploy.
model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  /// Free-text label shown on the card (e.g. "Private Equity").
  category    String        @default("")
  /// Editorial type — drives the cover image when no explicit one is set.
  type        String
  excerpt     String
  /// Sanitised HTML from the editor. Never rendered without passing through
  /// the same allowlist that produced it.
  bodyHtml    String        @default("")
  readTime    String        @default("")
  author      String
  authorRole  String        @default("")
  featured    Boolean       @default(false)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  coverId String?
  cover   MediaAsset? @relation("ArticleCover", fields: [coverId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([type])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

/**
 * ─────────────────────────────── live chat ─────────────────────────────────
 * Kwaku answers from the site's own content. When he cannot, the conversation
 * escalates: to a live staff member if one is online, otherwise it waits as a
 * message for an admin, and the reply is emailed to the visitor with a link
 * back into the same thread.
 * -------------------------------------------------------------------------
 */

enum ChatStatus {
  /**
   * Kwaku is handling it.
   */
  BOT
  /**
   * Escalated, nobody has picked it up yet.
   */
  WAITING
  /**
   * A staff member is in the conversation.
   */
  LIVE
  CLOSED
}

enum ChatRole {
  VISITOR
  KWAKU
  STAFF
}

model ChatConversation {
  id            String        @id @default(cuid())
  /**
   * Anonymous visitors are identified by a cookie value; signed-in users also
   * carry userId so staff can see who they are talking to.
   */
  visitorKey    String        @unique
  userId        String?
  user          User?         @relation("ChatVisitor", fields: [userId], references: [id])
  /**
   * Captured when a visitor leaves a message for a reply by email.
   */
  email         String?
  name          String?
  status        ChatStatus    @default(BOT)
  /**
   * Drives "are they still here?" when staff reply — if the visitor has gone,
   * the reply is emailed instead of only landing in a panel nobody is reading.
   */
  visitorSeenAt DateTime      @default(now())
  messages      ChatMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  body           String
  /**
   * Set when role is STAFF.
   */
  authorId       String?
  author         User?            @relation("ChatAuthor", fields: [authorId], references: [id])
  /**
   * Stamped when this message was emailed to an offline visitor, so a retry
   * or a second poll can never send it twice.
   */
  emailedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/**
 * One page view.
 * Deliberately holds no identifier that survives the day. `visitorDay` is a
 * hash of the IP, the user agent and a salt that rotates at midnight UTC and is
 * never written down — so today's rows cannot be joined to yesterday's, and
 * nobody (including us) can work backwards from a row to a person. The IP
 * itself is used to derive the country and is then discarded.
 * That is the whole reason this exists instead of Google Analytics: it answers
 * "how many people, from where, reading what" without ever building a profile.
 */
model PageView {
  id           String  @id @default(cuid())
  path         String
  /**
   * Host only — the full referring URL can carry search terms and tokens.
   */
  referrerHost String?

  /**
   * Resolved from the IP, which is then dropped.
   */
  country String?
  region  String?
  city    String?

  device  String
  os      String?
  browser String?

  /**
   * Rotates daily. Counts unique visitors within a day, and nothing across days.
   */
  visitorDay String
  /**
   * Groups views into a visit; rotates on the same salt with a 30-minute bucket.
   */
  sessionKey String
  /**
   * First view of this session — what makes a "visit" countable.
   */
  entry      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([country, createdAt])
  @@index([visitorDay, createdAt])
  @@index([sessionKey])
}

/**
 * One translated string.
 * Keyed by the ENGLISH SOURCE TEXT, not a symbolic id. That choice is what
 * makes the editor usable by someone who is not a developer: the row they are
 * correcting shows the sentence they saw on the site, not `home.subhead`. It
 * also means a string with no row simply renders as English, so the site is
 * never broken by a missing translation — only untranslated.
 * The cost is that editing English copy orphans its translations rather than
 * updating them. `source` is therefore treated as immutable once live, and the
 * editor surfaces orphans instead of hiding them.
 * Rows override the file dictionaries in lib/i18n/dictionaries.ts, which stay
 * as the seed and the fallback. A translator can fix a wording mistake without
 * a deploy; a developer adding a new string does not have to touch the database.
 */
model Translation {
  id     String @id @default(cuid())
  locale String
  source String
  value  String

  /**
   * Which page or area this appears on — the editor groups by it.
   */
  context String?
  /**
   * Cleared when a human edits, so machine output is visibly provisional.
   */
  machine Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([locale, source])
  @@index([locale, context])
}

/// Every transactional send, so the admin can answer "did it go out?".
///
/// The email page reported "15,560 sent · 63.4% open rate · 27.8% click rate".
/// Nothing recorded a send at all, and open and click rates need provider
/// webhooks that were never built. Sends are recordable; engagement is not,
/// without a feature nobody asked for — so this stores the first and the page
/// stopped claiming the second.
///
/// No body is stored. A transactional email contains the reader's own details,
/// and keeping a copy turns a mail log into a personal-data store with its own
/// retention question.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  /// sent | skipped (no provider configured) | failed
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Small key/value store for platform settings that an admin can change.
///
/// Added for the matching weights, which govern how every opportunity on the
/// platform is scored. The admin page tuned them and saved to localStorage —
/// written, never read back, not even by the page that wrote it — so an
/// operator could change the scoring model, see "Saved", and change nothing
/// anywhere. A setting that decides what investors are shown belongs on the
/// server.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/**
 * A meeting the platform arranged between an investor and a business.
 * Both sides are Users rather than a free-text name, so the meeting appears on
 * the right two dashboards without anybody matching strings — and so removing
 * an account takes its meetings with it.
 * `joinUrl` is supplied by whoever books it. There is deliberately no Zoom or
 * Google API integration: creating a meeting through those needs an OAuth app
 * per provider and a token per organiser, and pasting the link that Zoom or
 * Meet already gave you does the same job on day one. The provider is recorded
 * so the join button can name where it is going.
 * Times are stored as instants. The ICS feed and every dashboard render from
 * the same UTC value, so a Nairobi investor and a London deal lead cannot see
 * different times for the same call.
 */
model Meeting {
  id       String          @id @default(cuid())
  title    String
  agenda   String?
  /**
   * UTC instant. Duration is derived from endsAt, never stored twice.
   */
  startsAt DateTime
  endsAt   DateTime
  provider MeetingProvider @default(OTHER)
  joinUrl  String?
  location String?
  status   MeetingStatus   @default(SCHEDULED)

  /**
   * The listing this is about, when it is about one.
   */
  slug String?

  investorId  String
  investor    User    @relation("MeetingInvestor", fields: [investorId], references: [id], onDelete: Cascade)
  businessId  String
  business    User    @relation("MeetingBusiness", fields: [businessId], references: [id], onDelete: Cascade)
  organiserId String?
  organiser   User?   @relation("MeetingOrganiser", fields: [organiserId], references: [id], onDelete: SetNull)

  /**
   * Bumped on every edit and written into the ICS SEQUENCE, which is how a
   * calendar client knows an invitation is an update to one it already holds
   * rather than a second meeting.
   */
  revision Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([investorId, startsAt])
  @@index([businessId, startsAt])
}

enum MeetingProvider {
  ZOOM
  GOOGLE_MEET
  TEAMS
  IN_PERSON
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}
